# ── Server ─────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── GitHub ─────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your_random_secret_string

# ── LLM ───────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ──────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/reviewdb?sslmode=require

# ── Redis ─────────────────────────────────
# For Upstash (production):
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ── LangSmith (optional but recommended) ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_xxxxxxxxxxxx
LANGCHAIN_PROJECT=ai-code-reviewer

# ── RAG ───────────────────────────────────
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
